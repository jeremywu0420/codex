{
  "name": "sequential-circuit-studio",
  "version": "1.0.0",
  "description": "Serverless-backed EDA workbench for sequential circuit design: state tables to state diagrams, excitation tables, K-maps, circuit schematics, timing diagrams and Verilog.",
  "keywords": [
    "eda",
    "digital-logic",
    "fsm",
    "mealy",
    "moore",
    "flip-flop",
    "verilog",
    "k-map",
    "state-machine",
    "timing-diagram"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremywu0420/codex.git"
  },
  "homepage": "https://github.com/jeremywu0420/codex#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "build": "node scripts/clean-dist.cjs && tsc -b && npm run typecheck:functions && vite build --emptyOutDir=false",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 5174 --strictPort",
    "pages:dev": "wrangler pages dev"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "konva": "^9.3.20",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
